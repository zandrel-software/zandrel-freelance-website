<header class="site-header">
    <div class="container site-header__inner">
        <a class="site-header__brand"
           href="#inicio"
           aria-label="Zandrel - Inicio"
           @onclick="CloseMenu">
            <img src="images/brand/zandrel-logo-horizontal-transparent.png"
                 alt="Zandrel"
                 class="site-header__logo" />
        </a>

        <button class="site-header__menu-toggle"
                type="button"
                aria-label="@(_isMenuOpen ? "Cerrar menú" : "Abrir menú")"
                aria-controls="site-navigation"
                aria-expanded="@(_isMenuOpen ? "true" : "false")"
                @onclick="ToggleMenu">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <nav id="site-navigation"
             class="@($"site-header__navigation {(_isMenuOpen ? "site-header__navigation--open" : string.Empty)}")"
             aria-label="Navegación principal">

            <a href="#inicio"
               class="site-header__link"
               @onclick="CloseMenu">
                Inicio
            </a>

            <a href="#proyectos"
               class="site-header__link"
               @onclick="CloseMenu">
                Proyectos
            </a>

            <a href="#proceso"
               class="site-header__link"
               @onclick="CloseMenu">
                Cómo trabajamos
            </a>

            <a href="#contacto"
               class="site-header__link"
               @onclick="CloseMenu">
                Contacto
            </a>

            <a href="#contacto"
               class="button button--primary site-header__cta"
               @onclick="CloseMenu">
                Cuéntanos tu proyecto
            </a>
        </nav>
    </div>
</header>

@code {
    private bool _isMenuOpen;

    private void ToggleMenu()
    {
        _isMenuOpen = !_isMenuOpen;
    }

    private void CloseMenu()
    {
        _isMenuOpen = false;
    }
}